[Unit]
Description=Tapestry (Flask + Gunicorn)
# Redis backs the rate limiter -- don't start the app before it's up.
After=network.target redis-server.service
Wants=redis-server.service

[Service]
Type=notify
User=angeliki
Group=angeliki
WorkingDirectory=/home/angeliki/Desktop/myproject

# PRODUCTION=true turns on secure session cookies, HSTS and HTTPS redirects
# (see IS_PRODUCTION in app.py). Only correct once TLS is actually terminated
# in front of this service by nginx/Caddy -- until then the app is HTTP-only.
Environment="PRODUCTION=true"
Environment="RATE_LIMIT_STORAGE_URI=redis://127.0.0.1:6379"
Environment="HOST=127.0.0.1"
Environment="PORT=5000"

ExecStart=/home/angeliki/Desktop/myproject/venv/bin/gunicorn -c gunicorn.conf.py app:app
ExecReload=/bin/kill -s HUP $MAINPID

# Restart on crash, but give up if it's crash-looping on startup.
Restart=on-failure
RestartSec=5s

# Basic hardening: the service only ever needs to write to instance/ and static/.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/home/angeliki/Desktop/myproject/instance /home/angeliki/Desktop/myproject/static

[Install]
WantedBy=multi-user.target
